{
  "name": "vue-ts-tcss",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "docker:dev": "docker compose --env-file .env up",
    "docker:build": "docker compose build",
    "docker:down": "docker compose down",
    "debug:env": "echo 'Checking environment files:' && ls -la .env* && echo '\\n--- .env ---' && cat .env"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "hls.js": "1.5.15",
    "node": "^22.18.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.0.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.2.0",
    "@tsconfig/node20": "^20.1.6",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/tsconfig": "^0.7.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.5",
    "vue-tsc": "^2.2.0"
  }
}
